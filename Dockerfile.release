# Image published to ghcr.io/hakastein/gospy by goreleaser.
#
# It holds the statically linked gospy binary and nothing else. gospy drives
# phpspy, which attaches to a PHP process with ptrace, so gospy has to run in
# the same container as php-fpm. Use this image as a binary source there:
#
#   COPY --from=ghcr.io/hakastein/gospy:0.12.0 /gospy /usr/local/bin/gospy
#
# goreleaser puts the already built binaries in the build context under
# <os>/<arch>/, so there is no compile step here.
FROM scratch
ARG TARGETPLATFORM

COPY $TARGETPLATFORM/gospy /gospy

ENTRYPOINT ["/gospy"]
